// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  password     String
  name         String?
  avatar       String?
  role         Role    @default(USER)
  isActive     Boolean @default(true)
  refreshToken String? // bcrypt hashed, null = logged out

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Service {
  id          String  @id @default(cuid())
  slug        String  @unique // e.g., 'thu-am'
  number      String? // e.g., '01'
  title       String
  english     String?
  description String  @db.Text
  suitableFor String? @db.Text
  source      String?
  isMain      Boolean @default(true)
  order       Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services")
}

model Media {
  id             String  @id @default(cuid())
  src            String
  alt            String?
  title          String?
  category       String // "Không gian" | "Âm nhạc"
  description    String? @db.Text
  source         String?
  objectPosition String?
  order          Int     @default(0)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String  @db.Text
  category String  @default("general") // "general" | "pricing"
  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
  
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Consultation {
  id          String  @id @default(cuid())
  name        String
  contact     String
  service     String
  description String  @db.Text
  date        String?
  time        String?
  status      String  @default("PENDING") // PENDING, CONTACTED, DONE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("consultations")
}

model Beat {
  id              String   @id @default(cuid())
  title           String
  originalPrice   Int?
  discountedPrice Int?
  status          String   @default("available") // available | sold
  youtubeUrl      String
  genre           String?
  subgenre        String?
  typeBeat        String?
  isActive        Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("beats")
}

model MixTrack {
  id          String   @id @default(cuid())
  title       String
  artist      String   @default("Việt Hiphop Artist")
  packageType String   @default("Nâng cao") // "Cơ bản" | "Nâng cao" | "Chuyên nghiệp"
  category    String   @default("Nhạc phát hành") // "Nhạc phát hành" | "Cover" | "TVC" | "Giọng đọc"
  subCategory String?  // "Rap" | "RnB" | "Pop" | "Ballad" | "Nhạc cưới" | "Trữ tình" | "Tốp ca"
  youtubeUrl  String
  thumbUrl    String?
  description String? @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mix_tracks")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text // Tóm tắt ngắn
  content     String   @db.Text // Nội dung bài viết
  image       String?  // Ảnh bìa bài viết
  category    String   @default("Tin tức") // "Sự kiện" | "Tin tức" | "Workshop"
  author      String   @default("Việt Hiphop Studio")
  order       Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model AboutGalleryImage {
  id        String   @id @default(cuid())
  src       String
  caption   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_gallery_images")
}

model GearCategory {
  id        String     @id @default(cuid())
  title     String
  icon      String     @default("Mic2")
  order     Int        @default(0)
  isActive  Boolean    @default(true)
  items     GearItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("gear_categories")
}

model GearItem {
  id         String          @id @default(cuid())
  categoryId String
  category   GearCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  order      Int             @default(0)
  isActive   Boolean         @default(true)
  images     GearItemImage[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("gear_items")
}

model GearItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      GearItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  src       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("gear_item_images")
}

