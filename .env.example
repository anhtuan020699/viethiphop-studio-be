# ===========================
# App
# ===========================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===========================
# Database (MySQL)
# ===========================
DATABASE_URL=mysql://user:password@localhost:3306/viethiphop_db

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# CORS (comma separated)
# ===========================
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:5173

# ===========================
# Rate Limiting
# ===========================
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# ===========================
# Cloudflare R2 Storage
# ===========================
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_DOMAIN="https://pub-<token>.r2.dev"
