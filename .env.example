# ===========================
# App
# ===========================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ===========================
# Database (MySQL)
# Local / SSH tunnel: host 127.0.0.1
# Docker (network apps_shared): host mysql
# ===========================
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# CORS (comma separated)
# ===========================
CORS_ORIGINS=http://localhost:3001

# ===========================
# Rate Limiting
# ===========================
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

# ===========================
# Cloudflare R2 Storage
# ===========================
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
