# ===========================
# App
# ===========================
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# ===========================
# Database (PostgreSQL) - Đã đổi sang IP Server
# ===========================
DATABASE_URL=postgresql://root:secretpassword@192.168.1.191:5432/viethiphop_db

# ===========================
# JWT
# ===========================
JWT_ACCESS_SECRET=change_this_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================
# CORS (comma separated)
# ===========================
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:5173

# ===========================
# Rate Limiting
# ===========================
THROTTLE_TTL=60000
THROTTLE_LIMIT=10

